material {
  name: "NeonWall",
  shading_model: unlit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: vec4, name: color, hint: source_color, default: [0.02, 0.65, 1.0, 1.0] },
    { type: float, name: pulse, hint: range(0, 1, 0.01), default: 0.5 },
  ],
}

fragment {
  void Surface(inout MaterialInputs material) {
    float energy = 0.62 + material_params.pulse * 0.55;
    material.base_color = vec4(material_params.color.rgb * energy,
                               material_params.color.a);
    PrepareMaterial(material);
  }
}
